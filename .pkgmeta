# BigWigsMods/packager config (DATAFLOW.md 4b): tag vX.Y.Z -> CI zips the addon,
# uploads to CurseForge + Wago Addons + GitHub Releases. Only Foresight/ ships; the
# pipeline, docs, and agent tooling stay repo-only.
package-as: Foresight
enable-nolib-creation: no

move-folders:
    Foresight/Foresight: Foresight

ignore:
    - pipeline
    - web          # S13 companion web app (Firebase) - never ships inside the addon
    - docs
    - mockups
    - .claude
    - CLAUDE.md
    - DATAFLOW.md
    - DESIGN.md
    - FEASIBILITY.md
    - FEATURES.md
    - SPRINTS.md
    - README.md

# No manual-changelog: the curated CHANGELOG.md is the full project history and ships
# in the zip, but it is far larger than GitHub's 125k release-body cap. Let the packager
# auto-generate a per-release changelog from the commit messages since the previous tag
# (our commits are descriptive) - that becomes the GitHub/CurseForge release notes.
