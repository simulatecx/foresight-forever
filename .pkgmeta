# BigWigsMods/packager config (DATAFLOW.md 4b): tag vX.Y.Z -> CI zips the addon,
# uploads to CurseForge + Wago Addons + GitHub Releases. Only Foresight/ ships; the
# pipeline, docs, and agent tooling stay repo-only.
package-as: Foresight
enable-nolib-creation: no

move-folders:
    Foresight/Foresight: Foresight

# NO INLINE COMMENTS in this list - the packager's YAML subset does not strip them, so an
# inline-commented entry silently never matches (the v0.49.0 zip shipped web/ because of one).
# The repo-root `data/` (pipeline schema source) MUST be ignored: it collides with the addon's
# own data/ during move-folders and strands every data/*.lua in a nested Foresight/Foresight/
# (the v0.49.0 package was non-functional out of the zip because of this).
ignore:
    - pipeline
    - web
    - data
    - functions
    - firebase.json
    - CHANGELOG.md
    - docs
    - mockups
    - .claude
    - CLAUDE.md
    - DATAFLOW.md
    - DESIGN.md
    - FEASIBILITY.md
    - FEATURES.md
    - SPRINTS.md
    - README.md

# Release notes are a short, hand-written, player-facing file - deliberately NOT the full
# CHANGELOG.md (that is the dense dev history and is already past GitHub's 125k release-
# body cap). Rewrite .github/RELEASE_NOTES.md with this version's notes before each tag;
# it becomes the CurseForge + GitHub release notes. (.github is auto-excluded from the zip.)
manual-changelog:
    filename: .github/RELEASE_NOTES.md
    markdown-to-bbcode: true
